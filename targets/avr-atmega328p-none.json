{
  "arch": "avr",
  "cpu": "atmega328p",
  "data-layout": "e-P1-p:16:8-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-n8-a:8",
  "linker-flavor": "ld",
  "llvm-target": "avr-unknown-none",
  "max-atomic-width": 0,
  "panic-strategy": "abort",
  "target-pointer-width": "16",
  "description": "AVR ATmega328P (Arduino Uno) — bare metal, no OS, no std, no atomics. Requires avr-gcc for linking."
}
